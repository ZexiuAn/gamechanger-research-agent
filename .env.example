# Rename this file to .env and supply your API keys.
# Do NOT commit real credentials to GitHub.

# Anthropic API Key (Default recommended for Claude 3.5 Sonnet + MCP)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API Key (Optional for GPT-4o / GPT-4o-mini)
OPENAI_API_KEY=your_openai_api_key_here

# DashScope API Key (Optional for Qwen fallback)
DASHSCOPE_API_KEY=

# Search / Reader Keys (Optional)
TAVILY_API_KEY=
JINA_API_KEY=

# Optional: Enable browser automation
ENABLE_BROWSER=0
